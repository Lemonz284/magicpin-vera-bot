# Server Configuration
PORT=8080
LOG_LEVEL=INFO

# Bot Metadata
TEAM_NAME=Vera Bot
CONTACT_EMAIL=builder@example.com

# LLM Provider Configuration
# Supported providers: openai, gemini, anthropic, groq, openrouter, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional provider-specific API keys if not using LLM_API_KEY
OPENAI_API_KEY=
GOOGLE_GENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
